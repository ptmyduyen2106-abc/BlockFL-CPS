# Chain mặc định để ĐỌC dữ liệu: 31337 (Hardhat local) hoặc 11155111 (Sepolia)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337
# RPC cho Sepolia (Alchemy/Infura) - nếu bỏ trống dùng RPC công khai
NEXT_PUBLIC_SEPOLIA_RPC_URL=
# Bật = 1 để dùng dữ liệu MÔ PHỎNG (demo/dự phòng, có banner cảnh báo). Để trống khi dùng dữ liệu on-chain thật
NEXT_PUBLIC_USE_MOCK=
# Firebase Realtime Database (dữ liệu cảm biến realtime hiển thị trên dashboard). Bỏ trống = ẩn panel.
# Đặt giá trị thật trong dashboard/.env.local (đã nằm ngoài git), KHÔNG commit vào .env.example.
NEXT_PUBLIC_FIREBASE_DB_URL=
NEXT_PUBLIC_FIREBASE_PATH=uav_logs
