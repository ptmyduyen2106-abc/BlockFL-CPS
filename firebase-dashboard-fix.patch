From a27ab5d8a00ae7bd0fe06c7ceda43ca250a8fc70 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 07:21:44 +0000
Subject: [PATCH] fix(dashboard): read /sensor + /uav_logs, allow LAN dev
 origin, decouple Firebase panel from chain loading

---
 dashboard/.env.example                    |  2 +-
 dashboard/next.config.mjs                 |  7 +++-
 dashboard/src/app/page.jsx                |  5 +--
 dashboard/src/components/SensorPanel.jsx  | 36 +++++++++++++--------
 dashboard/src/components/useSensorData.js |  6 ++--
 dashboard/src/lib/firebase.js             | 39 ++++++++++++++++-------
 6 files changed, 62 insertions(+), 33 deletions(-)

diff --git a/dashboard/.env.example b/dashboard/.env.example
index 0f29b3b..713f1c4 100644
--- a/dashboard/.env.example
+++ b/dashboard/.env.example
@@ -7,4 +7,4 @@ NEXT_PUBLIC_USE_MOCK=
 # Firebase Realtime Database (dữ liệu cảm biến realtime hiển thị trên dashboard). Bỏ trống = ẩn panel.
 # Đặt giá trị thật trong dashboard/.env.local (đã nằm ngoài git), KHÔNG commit vào .env.example.
 NEXT_PUBLIC_FIREBASE_DB_URL=
-NEXT_PUBLIC_FIREBASE_PATH=sensor
+NEXT_PUBLIC_FIREBASE_PATH=uav_logs
diff --git a/dashboard/next.config.mjs b/dashboard/next.config.mjs
index 5b7e0f5..cc4900d 100644
--- a/dashboard/next.config.mjs
+++ b/dashboard/next.config.mjs
@@ -1,3 +1,8 @@
 /** @type {import('next').NextConfig} */
-const nextConfig = { reactStrictMode: true };
+const nextConfig = {
+  reactStrictMode: true,
+  // Cho phép mở dashboard (next dev) bằng IP mạng LAN, vd http://192.168.62.1:3000.
+  // Next 16 mặc định chặn các file /_next/* từ origin khác localhost → trang kẹt ở "Đang tải…".
+  allowedDevOrigins: ["192.168.*.*", "10.*.*.*", "172.16.*.*", "*.local"],
+};
 export default nextConfig;
diff --git a/dashboard/src/app/page.jsx b/dashboard/src/app/page.jsx
index b4be0fa..ee4339a 100644
--- a/dashboard/src/app/page.jsx
+++ b/dashboard/src/app/page.jsx
@@ -11,8 +11,9 @@ const STATUS = ["—", "Đang mở", "Đã chốt"];
 export default function Dashboard() {
   const { data, error, loading, chainId } = useChainData();
   const w = useWallet();
-  if (error && !data) return <ErrorBox msg={error} />;
-  if (loading || !data) return <Spinner />;
+  // Panel Firebase độc lập với chain: vẫn hiện khi RPC lỗi hoặc đang tải
+  if (error && !data) return <div className="space-y-6"><ErrorBox msg={error} /><SensorPanel /></div>;
+  if (loading || !data) return <div className="space-y-6"><Spinner /><SensorPanel /></div>;
 
   const done = data.rounds.filter((r) => r.status === 2);
   const labels = done.map((r) => String(r.id));
diff --git a/dashboard/src/components/SensorPanel.jsx b/dashboard/src/components/SensorPanel.jsx
index 48bb6f5..12af01e 100644
--- a/dashboard/src/components/SensorPanel.jsx
+++ b/dashboard/src/components/SensorPanel.jsx
@@ -4,13 +4,17 @@ import { LineChart, Stat } from "./ui";
 import { FIREBASE_DB_URL } from "@/lib/firebase";
 
 const hhmm = (ms) => new Date(ms).toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
+// chỉ in nhãn trục x thưa để không bị chồng chữ
+const sparse = (arr, fmt) => arr.map((r, i) => (i % Math.max(1, Math.ceil(arr.length / 6)) === 0 ? fmt(r) : ""));
 
-/** Dữ liệu cảm biến realtime từ Firebase (đường dự phòng của ESP32 → RTDB) */
+/** Dữ liệu cảm biến realtime từ Firebase RTDB: giá trị hiện tại (/sensor) + lịch sử (/uav_logs) */
 export default function SensorPanel() {
-  const { rows, error } = useSensorData();
+  const { data, error } = useSensorData();
   if (!FIREBASE_DB_URL) return null;
-  const last = rows?.[rows.length - 1];
-  const labels = (rows || []).map((r) => hhmm(r.time));
+  const live = data?.live, hist = data?.history || [], th = data?.thresholds;
+  const lastGas = hist[hist.length - 1]?.gas;
+  const labels = sparse(hist, (r) => hhmm(r.time));
+  const hasTH = hist.some((r) => r.temp !== null || r.humi !== null);
 
   return (
     <div className="space-y-4">
@@ -18,26 +22,30 @@ export default function SensorPanel() {
         <h2 className="text-xl font-extrabold">Cảm biến realtime <span className="text-sm font-normal text-mute">· Firebase RTDB</span></h2>
         <a className="ext text-xs" href={FIREBASE_DB_URL} target="_blank" rel="noreferrer">Mở Firebase ↗</a>
       </div>
-      {error && !rows ? (
+      {error && !data ? (
         <div className="card border-bad/40 p-4 text-sm text-bad">⚠ Không đọc được Firebase: {error}</div>
-      ) : !rows ? (
+      ) : !data ? (
         <div className="p-4 text-center text-sm text-mute">Đang tải dữ liệu cảm biến…</div>
       ) : (
         <>
           <div className="grid grid-cols-2 gap-4 lg:grid-cols-4">
-            <Stat label="Nhiệt độ" value={last ? `${last.temp.toFixed(1)}°C` : "—"} sub={last ? `Lúc ${hhmm(last.time)}` : "Chưa có bản ghi"} tone="sun" />
-            <Stat label="Độ ẩm" value={last ? `${last.humi}%` : "—"} sub="DHT" tone="violet" />
-            <Stat label="Khí gas (MQ ADC)" value={last ? last.gas : "—"} sub={last && (last.gas <= 0 || last.gas >= 4095) ? "Tín hiệu MQ không hợp lệ" : "12-bit ADC"} tone="pink" />
-            <Stat label="Số bản ghi hiển thị" value={rows.length} sub="Mới nhất từ Firebase" tone="lime" />
+            <Stat label="Nhiệt độ" value={live ? `${live.temp}°C` : "—"} sub={th && live && live.temp > th.temperatureMax ? `⚠ Vượt ngưỡng ${th.temperatureMax}°C` : "Giá trị hiện tại"} tone="sun" />
+            <Stat label="Độ ẩm" value={live ? `${live.humi}%` : "—"} sub="Giá trị hiện tại" tone="violet" />
+            <Stat label="Khí gas (MQ ADC)" value={lastGas ?? "—"} sub={th && lastGas > th.gasMax ? `⚠ Vượt ngưỡng ${th.gasMax}` : "Bản ghi mới nhất"} tone="pink" />
+            <Stat label="Bụi" value={live?.dust ?? "—"} sub={`${hist.length} bản ghi lịch sử`} tone="lime" />
           </div>
           <div className="grid gap-4 lg:grid-cols-2">
             <div className="card p-4">
-              <h3 className="mb-2 text-sm font-semibold">Nhiệt độ (°C)</h3>
-              <LineChart labels={labels} yFmt={(v) => v.toFixed(1)} series={[{ name: "Temp", color: "var(--color-warn)", values: rows.map((r) => r.temp) }]} />
+              <h3 className="mb-2 text-sm font-semibold">Gas theo thời gian</h3>
+              <LineChart labels={labels} yFmt={(v) => v.toFixed(0)} series={[{ name: "Gas", color: "var(--color-warn)", values: hist.map((r) => r.gas) }]} />
             </div>
             <div className="card p-4">
-              <h3 className="mb-2 text-sm font-semibold">Độ ẩm (%)</h3>
-              <LineChart labels={labels} yFmt={(v) => `${v.toFixed(0)}%`} series={[{ name: "Humi", color: "var(--color-brand-2)", values: rows.map((r) => r.humi) }]} />
+              <h3 className="mb-2 text-sm font-semibold">Nhiệt độ & độ ẩm theo thời gian</h3>
+              {hasTH
+                ? <LineChart labels={labels} yFmt={(v) => v.toFixed(0)} series={[
+                    { name: "Temp (°C)", color: "var(--color-warn)", values: hist.map((r) => r.temp) },
+                    { name: "Humi (%)", color: "var(--color-brand-2)", values: hist.map((r) => r.humi) }]} />
+                : <div className="p-6 text-center text-sm text-mute">Các bản ghi lịch sử gần đây chưa có nhiệt độ/độ ẩm hợp lệ (DHT trả 0).</div>}
             </div>
           </div>
         </>
diff --git a/dashboard/src/components/useSensorData.js b/dashboard/src/components/useSensorData.js
index dc3e8d1..0d9c1ff 100644
--- a/dashboard/src/components/useSensorData.js
+++ b/dashboard/src/components/useSensorData.js
@@ -4,17 +4,17 @@ import { loadSensorData } from "@/lib/firebase";
 
 /** Poll Firebase mỗi 10s */
 export default function useSensorData(intervalMs = 10000) {
-  const [rows, setRows] = useState(null);
+  const [data, setData] = useState(null);
   const [error, setError] = useState("");
   useEffect(() => {
     let alive = true;
     const load = async () => {
-      try { const r = await loadSensorData(); if (alive) { setRows(r); setError(""); } }
+      try { const d = await loadSensorData(); if (alive) { setData(d); setError(""); } }
       catch (e) { if (alive) setError(e.message); }
     };
     load();
     const t = setInterval(load, intervalMs);
     return () => { alive = false; clearInterval(t); };
   }, [intervalMs]);
-  return { rows, error };
+  return { data, error };
 }
diff --git a/dashboard/src/lib/firebase.js b/dashboard/src/lib/firebase.js
index 85ca0e4..5bac56b 100644
--- a/dashboard/src/lib/firebase.js
+++ b/dashboard/src/lib/firebase.js
@@ -1,28 +1,43 @@
 // Đọc dữ liệu cảm biến từ Firebase Realtime Database (REST, không cần SDK).
+// Cấu trúc RTDB của dự án:
+//   /sensor                      – giá trị HIỆN TẠI {temp, humi, dust, mpu}
+//   /uav_logs/<pushId>           – LỊCH SỬ {gas, humi, temp, alt, lat, lng, timestamp}
+//   /settings/thresholds         – ngưỡng cảnh báo {gasMax, temperatureMax, humidityMin}
 // Cấu hình qua biến môi trường (xem .env.example):
 //   NEXT_PUBLIC_FIREBASE_DB_URL  – URL gốc của RTDB
-//   NEXT_PUBLIC_FIREBASE_PATH    – node chứa bản ghi cảm biến (mặc định "sensor")
+//   NEXT_PUBLIC_FIREBASE_PATH    – node lịch sử (mặc định "uav_logs")
 export const FIREBASE_DB_URL = (process.env.NEXT_PUBLIC_FIREBASE_DB_URL || "").replace(/\/+$/, "");
-export const FIREBASE_PATH = (process.env.NEXT_PUBLIC_FIREBASE_PATH || "sensor").replace(/^\/+|\/+$/g, "");
+export const FIREBASE_PATH = (process.env.NEXT_PUBLIC_FIREBASE_PATH || "uav_logs").replace(/^\/+|\/+$/g, "");
 
 const ALPHABET = "-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz";
-/** Firebase push ID mã hoá mili-giây trong 8 ký tự đầu (cột timestamp xuất file không đáng tin) */
+/** Firebase push ID mã hoá mili-giây trong 8 ký tự đầu (trường timestamp trong log không đáng tin) */
 export const pushTime = (id) => {
   let t = 0;
   for (const c of id.slice(0, 8)) t = t * 64 + ALPHABET.indexOf(c);
   return t;
 };
 
-/** Lấy N bản ghi mới nhất, đã lọc dòng DHT lỗi (humi/temp = 0) */
+const get = async (path, params) => {
+  const qs = params ? `?${new URLSearchParams(params)}` : "";
+  const res = await fetch(`${FIREBASE_DB_URL}/${path}.json${qs}`, { cache: "no-store" });
+  if (!res.ok) throw new Error(`Firebase trả về ${res.status}${res.status === 401 ? " – kiểm tra rules đọc" : ""}`);
+  return res.json();
+};
+
+// DHT trả 0 khi đọc lỗi → coi là "không có dữ liệu" (null) thay vì vẽ số 0
+const valid = (v) => (Number(v) > 0 ? Number(v) : null);
+
+/** Giá trị hiện tại + N bản ghi lịch sử mới nhất + ngưỡng cảnh báo */
 export async function loadSensorData(limit = 60) {
   if (!FIREBASE_DB_URL) throw new Error("Chưa cấu hình NEXT_PUBLIC_FIREBASE_DB_URL");
-  const q = new URLSearchParams({ orderBy: '"$key"', limitToLast: String(limit) });
-  const res = await fetch(`${FIREBASE_DB_URL}/${FIREBASE_PATH}.json?${q}`, { cache: "no-store" });
-  if (!res.ok) throw new Error(`Firebase trả về ${res.status}${res.status === 401 ? " – kiểm tra rules đọc" : ""}`);
-  const raw = (await res.json()) || {};
-  return Object.entries(raw)
-    .filter(([, v]) => v && typeof v === "object" && "gas" in v && "humi" in v && "temp" in v)
-    .map(([id, v]) => ({ id, time: pushTime(id), gas: Number(v.gas), humi: Number(v.humi), temp: Number(v.temp) }))
-    .filter((r) => r.humi > 0 && r.temp > 0)
+  const [live, logs, thresholds] = await Promise.all([
+    get("sensor"),
+    get(FIREBASE_PATH, { orderBy: '"$key"', limitToLast: String(limit) }),
+    get("settings/thresholds").catch(() => null),
+  ]);
+  const history = Object.entries(logs || {})
+    .filter(([, v]) => v && typeof v === "object" && "gas" in v)
+    .map(([id, v]) => ({ id, time: pushTime(id), gas: Number(v.gas), humi: valid(v.humi), temp: valid(v.temp) }))
     .sort((a, b) => a.time - b.time);
+  return { live: live && typeof live === "object" ? live : null, history, thresholds };
 }
-- 
